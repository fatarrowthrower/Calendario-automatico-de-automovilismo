  {
    "uid": "actc-tc-pista-2026-10-04-0726-l-tc-pista-abrio-la-actividad-en-este-hermoso-domingo-sin-nubes-en-el-cielo-y-con-una-temperatura-mas-que-agradable-con-las-series-matutinas-en-la-primera-bateria-el-ganador-fue-eugenio-provens-y-en-la-segunda-lo-hizo-gabriel-gandulia-ambos-largaran-desde-la-fila-1-en-la-final-de-la-categoria",
    "categoria": "Argentina",
    "campeonato": "TC Pista",
    "tipo": "Serie",
